{
  "name": "@chatenhancer/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repoTools": {
    "checks": [
      "astro-check",
      "lint"
    ]
  },
  "scripts": {
    "predev": "npm run build",
    "dev": "astro dev --force",
    "astro-check": "astro check",
    "check": "npm run checks -w @chatenhancer/repo-tools -- --concurrency=2 @chatenhancer/docs",
    "build": "npm run docs:validate-locales -w @chatenhancer/repo-tools && astro build --force && pagefind --site ../../dist/docs --silent",
    "preview": "npm run build && astro preview",
    "test": "vitest run",
    "lint": "eslint src astro.config.mjs eslint.config.mjs vitest.config.ts"
  },
  "dependencies": {
    "@chatenhancer/product-config": "0.0.0"
  },
  "devDependencies": {
    "@chatenhancer/eslint-config": "0.0.0",
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.2",
    "astro": "^7.2.8",
    "jsdom": "^29.1.1",
    "pagefind": "^1.5.2",
    "vitest": "^5.0.0"
  }
}
