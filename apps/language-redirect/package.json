{
  "name": "@chatenhancer/language-redirect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repoTools": {
    "checks": [
      "typecheck",
      "lint"
    ]
  },
  "scripts": {
    "check": "npm run checks -w @chatenhancer/repo-tools -- --concurrency=2 @chatenhancer/language-redirect",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src eslint.config.mjs vitest.config.ts",
    "test": "vitest run",
    "check:deploy": "cross-env WRANGLER_LOG_PATH=../../.wrangler/logs wrangler deploy --dry-run",
    "dev": "cross-env WRANGLER_LOG_PATH=../../.wrangler/logs wrangler dev",
    "deploy": "cross-env WRANGLER_LOG_PATH=../../.wrangler/logs wrangler deploy"
  },
  "dependencies": {
    "@chatenhancer/product-config": "0.0.0"
  },
  "devDependencies": {
    "@chatenhancer/eslint-config": "0.0.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "cross-env": "^7.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.120.0"
  }
}
