{
  "name": "@chatenhancer/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repoTools": {
    "checks": [
      "typecheck",
      "lint",
      "format:check"
    ]
  },
  "browser": {
    "fs": false,
    "path": false,
    "readline": false,
    "worker_threads": false
  },
  "scripts": {
    "build": "npm run extension:build -w @chatenhancer/repo-tools -- --all",
    "build:chrome": "npm run extension:build -w @chatenhancer/repo-tools -- --target=chrome",
    "build:chrome:playground-local": "npm run extension:build -w @chatenhancer/repo-tools -- --target=chrome --playground-backend=http://127.0.0.1:8787",
    "build:edge": "npm run extension:build -w @chatenhancer/repo-tools -- --target=edge",
    "build:firefox": "npm run extension:build -w @chatenhancer/repo-tools -- --target=firefox",
    "build:firefox:playground-local": "npm run extension:build -w @chatenhancer/repo-tools -- --target=firefox --playground-backend=http://127.0.0.1:8787",
    "build:safari": "npm run extension:build -w @chatenhancer/repo-tools -- --target=safari",
    "build:safari:xcode": "npm run build:safari && npm run safari:package -w @chatenhancer/repo-tools",
    "build:safari:app": "npm run build:safari:xcode && npm run safari:build-app -w @chatenhancer/repo-tools",
    "build:safari:archive": "npm run build:safari:xcode && npm run safari:distribute -w @chatenhancer/repo-tools -- --archive",
    "build:playground-local": "npm run build:chrome:playground-local && npm run build:firefox:playground-local",
    "check": "npm run checks -w @chatenhancer/repo-tools -- --concurrency=3 @chatenhancer/extension",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "npm run e2e:test -w @chatenhancer/repo-tools --",
    "test:e2e:ci": "npm run e2e:test -w @chatenhancer/repo-tools -- --no-build --project=extension-pages --project=youtube-mock --project=youtube-live-logged-out --project=integrations --workers=4",
    "test:e2e:ci:deterministic": "npm run e2e:test -w @chatenhancer/repo-tools -- --no-build --project=extension-pages --project=youtube-mock --workers=4",
    "test:e2e:ci:youtube": "npm run e2e:test -w @chatenhancer/repo-tools -- --no-build --project=youtube-live-logged-out --workers=1",
    "test:e2e:extension-pages": "npm run e2e:test -w @chatenhancer/repo-tools -- --project=extension-pages",
    "test:e2e:flake": "npm run e2e:flake -w @chatenhancer/repo-tools --",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install-deps": "playwright install --with-deps chromium",
    "test:e2e:integrations": "npm run e2e:test -w @chatenhancer/repo-tools -- --project=integrations",
    "test:e2e:scheduled": "npm run e2e:test -w @chatenhancer/repo-tools -- --no-build --project=youtube-live-logged-out --project=integrations --workers=2",
    "test:e2e:perf": "npm run e2e:performance -w @chatenhancer/repo-tools --",
    "test:e2e:perf:live": "npm run e2e:performance -w @chatenhancer/repo-tools -- --project=youtube-live-performance",
    "test:e2e:youtube:mock": "npm run e2e:test -w @chatenhancer/repo-tools -- --project=youtube-mock",
    "test:e2e:youtube:live": "npm run e2e:test -w @chatenhancer/repo-tools -- --project=youtube-live-logged-in --project=youtube-live-logged-out",
    "test:e2e:youtube:live:logged-in": "npm run e2e:test -w @chatenhancer/repo-tools -- --project=youtube-live-logged-in",
    "test:e2e:youtube:live:logged-out": "npm run e2e:test -w @chatenhancer/repo-tools -- --project=youtube-live-logged-out",
    "test:e2e:youtube:replay": "npm run e2e:test -w @chatenhancer/repo-tools -- --project=youtube-replay-logged-in",
    "test:e2e:youtube-login": "npm run e2e:open-profile -w @chatenhancer/repo-tools",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src e2e eslint.config.mjs playwright.config.ts playwright.perf.config.ts vitest.setup.ts vitest.unit.config.ts",
    "format": "prettier --write \"src/**/*.tsx\"",
    "format:check": "prettier --check \"src/**/*.tsx\""
  },
  "dependencies": {
    "@chatenhancer/playground-core": "0.0.0",
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@chatenhancer/eslint-config": "0.0.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.315",
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "vitest": "^5.0.0"
  }
}
