# Copy to .env for local builds. Do not check in .env.

# Mac App Store / Safari
YTCQ_SAFARI_BUNDLE_ID=
YTCQ_SAFARI_DEVELOPMENT_TEAM=
YTCQ_APP_STORE_APPLE_ID=
YTCQ_APP_STORE_CONNECT_KEY_ID=
YTCQ_APP_STORE_CONNECT_ISSUER_ID=
# CI enables this to cancel an older pending release, detach its build, and
# update its version number before submitting the processed replacement build.
# Local publishing keeps the existing behavior unless explicitly enabled.
YTCQ_APP_STORE_REPLACE_PENDING=false

# Chrome Web Store
CHROME_WEBSTORE_EXTENSION_ID=
CHROME_WEBSTORE_PUBLISHER_ID=

# Firefox Add-ons
FIREFOX_AMO_ADDON_ID=
