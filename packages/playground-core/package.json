{
  "name": "@chatenhancer/playground-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repoTools": {
    "checks": [
      "typecheck",
      "lint"
    ]
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "npm run checks -w @chatenhancer/repo-tools -- --concurrency=2 @chatenhancer/playground-core",
    "lint": "eslint src eslint.config.mjs vitest.unit.config.ts",
    "test": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@chatenhancer/eslint-config": "0.0.0",
    "vitest": "^5.0.0"
  }
}
