{
  "name": "youtube-chat-qol",
  "version": "1.0.3",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "repoTools": {
    "checks": [
      "lint:config"
    ]
  },
  "scripts": {
    "build": "npm run build -w @chatenhancer/extension",
    "build:chrome": "npm run build:chrome -w @chatenhancer/extension",
    "build:edge": "npm run build:edge -w @chatenhancer/extension",
    "build:firefox": "npm run build:firefox -w @chatenhancer/extension",
    "build:safari": "npm run build:safari -w @chatenhancer/extension",
    "build:safari:app": "npm run build:safari:app -w @chatenhancer/extension",
    "build:playground-local": "npm run build:playground-local -w @chatenhancer/extension",
    "docs:dev": "npm run dev -w @chatenhancer/docs --",
    "docs:build": "npm run build -w @chatenhancer/docs",
    "docs:preview": "npm run preview -w @chatenhancer/docs --",
    "zip": "npm run verify && npm run release:zip -w @chatenhancer/repo-tools",
    "cloudflare:check": "npm run check:deploy -w @chatenhancer/language-redirect && npm run check:deploy -w @chatenhancer/playground",
    "cloudflare:test": "npm run cloudflare:test -w @chatenhancer/repo-tools",
    "cloudflare:test:python": "npm run cloudflare:test -w @chatenhancer/repo-tools -- --python-only",
    "cloudflare:test:ts": "npm run cloudflare:test -w @chatenhancer/repo-tools -- --typescript-only",
    "demo:walkthrough": "npm run build:chrome && npm run walkthrough:capture-locales -w @chatenhancer/repo-tools",
    "demo:walkthrough:preview": "npm run build:chrome && npm run walkthrough:capture -w @chatenhancer/repo-tools -- --preview",
    "demo:walkthrough:release": "npm run demo:walkthrough && npm run walkthrough:publish -w @chatenhancer/repo-tools",
    "postinstall": "npm run setup:playwright -w @chatenhancer/repo-tools",
    "publish:chrome": "npm run publish:chrome -w @chatenhancer/repo-tools",
    "publish:firefox": "npm run publish:firefox -w @chatenhancer/repo-tools",
    "publish:safari": "npm run build:safari:xcode -w @chatenhancer/extension && npm run safari:distribute -w @chatenhancer/repo-tools -- --upload && npm run publish:safari -w @chatenhancer/repo-tools",
    "test": "npm run test:unit -w @chatenhancer/repo-tools && npm run cloudflare:test && npm run test -w @chatenhancer/docs",
    "test:all": "npm run test && npm run test:e2e && npm run test:e2e:perf",
    "test:coverage": "npm run test:unit -w @chatenhancer/repo-tools -- --coverage && npm run coverage:notice -w @chatenhancer/repo-tools",
    "test:e2e": "npm run test:e2e -w @chatenhancer/extension --",
    "test:e2e:extension-pages": "npm run test:e2e:extension-pages -w @chatenhancer/extension --",
    "test:e2e:flake": "npm run test:e2e:flake -w @chatenhancer/extension --",
    "test:e2e:integrations": "npm run test:e2e:integrations -w @chatenhancer/extension --",
    "test:e2e:perf": "npm run test:e2e:perf -w @chatenhancer/extension --",
    "test:e2e:youtube:mock": "npm run test:e2e:youtube:mock -w @chatenhancer/extension --",
    "test:e2e:youtube:live": "npm run test:e2e:youtube:live -w @chatenhancer/extension --",
    "test:e2e:youtube:live:logged-in": "npm run test:e2e:youtube:live:logged-in -w @chatenhancer/extension --",
    "test:e2e:youtube:live:logged-out": "npm run test:e2e:youtube:live:logged-out -w @chatenhancer/extension --",
    "test:e2e:youtube:replay": "npm run test:e2e:youtube:replay -w @chatenhancer/extension --",
    "test:watch": "vitest",
    "version:bump": "npm run release:bump-version -w @chatenhancer/repo-tools",
    "release:tag": "npm run release:create-tag -w @chatenhancer/repo-tools --",
    "release:retry": "npm run release:retry -w @chatenhancer/repo-tools --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format -w @chatenhancer/extension",
    "format:check": "npm run format:check -w @chatenhancer/extension",
    "lint": "npm run lint --workspaces --if-present && npm run lint:config",
    "lint:config": "eslint eslint.config.mjs vitest.config.mjs",
    "check": "npm run checks -w @chatenhancer/repo-tools -- --all --concurrency=2",
    "verify": "npm run check && npm run test:coverage && npm run build && npm run cloudflare:test && npm run cloudflare:check && npm run test:e2e:ci -w @chatenhancer/extension"
  },
  "devDependencies": {
    "@chatenhancer/eslint-config": "0.0.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.27.0",
    "prettier": "^3.8.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
